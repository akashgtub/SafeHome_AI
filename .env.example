# SafeHome AI - Environment Configuration Template
# Copy this file to .env (or backend/.env) and populate with your production credentials.
# NEVER commit real API keys or secrets to version control.

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
CORS_ORIGINS=https://safehome-ai-frontend.onrender.com,http://localhost:5173

# Database & Storage
DATABASE_URL=sqlite:///./data/safehome.db
UPLOAD_DIR=./data/uploads
FRAMES_DIR=./data/frames
SAMPLE_DIR=./data/sample

# Upload Limits
MAX_UPLOAD_SIZE_MB=200
MAX_VIDEO_DURATION_SECONDS=600

# Vision AI Configuration (Providers: "gemini", "openai", "local")
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Amazon Ring / Vision Partner Integration
RING_CLIENT_ID=your_ring_client_id_here
RING_CLIENT_SECRET=your_ring_client_secret_here
RING_REDIRECT_URI=https://your-backend-domain.onrender.com/api/ring/oauth/callback
RING_WEBHOOK_SECRET=your_webhook_hmac_secret_here
RING_SIMULATOR_MODE=True

# Privacy & Retention Defaults
DEFAULT_RETENTION_DAYS=30
AUTO_DELETE_EXPIRED=False
BLUR_FACES_DEFAULT=False
