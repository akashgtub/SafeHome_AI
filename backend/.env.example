# SafeHome AI Backend Configuration

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
DATABASE_URL=sqlite:///./data/safehome.db

# Storage Directories
UPLOAD_DIR=./data/uploads
FRAMES_DIR=./data/frames
SAMPLE_DIR=./data/sample

# Video Upload Constraints
MAX_UPLOAD_SIZE_MB=200
MAX_VIDEO_DURATION_SECONDS=600

# Vision AI Configuration
# Providers: "mock" (built-in intelligent edge CV), "gemini", "openai"
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Amazon Vision / Ring Partner API Configuration
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_REDIRECT_URI=http://localhost:8000/api/ring/oauth/callback
RING_WEBHOOK_SECRET=
# When RING_SIMULATOR_MODE=True, the system runs an official Amazon Vision JSON:API spec-compliant simulator
RING_SIMULATOR_MODE=True

# Privacy & Retention
DEFAULT_RETENTION_DAYS=30
AUTO_DELETE_EXPIRED=False
BLUR_FACES_DEFAULT=False
